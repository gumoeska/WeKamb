{
    "name": "wekamb",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "engines": {
        "node": ">=20.13.1"
    },
    "scripts": {
        "dev": "npm run dev --workspace @wekamb/web --",
        "build": "npm run typecheck && npm run build --workspace @wekamb/web",
        "typecheck": "npm run typecheck --workspaces --if-present",
        "lint": "eslint . --max-warnings 0",
        "test": "npm run test --workspaces --if-present",
        "format": "prettier --write apps packages tooling *.js *.json",
        "format:check": "prettier --check apps packages tooling *.js *.json",
        "preview": "npm run preview --workspace @wekamb/web --"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/node": "^20.14.10",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react-swc": "^3.11.0",
        "autoprefixer": "^10.4.19",
        "eslint": "^9.39.4",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.7",
        "postcss": "^8.5.32",
        "prettier": "^3.9.10",
        "tailwindcss": "^3.4.4",
        "tailwindcss-animate": "^1.0.7",
        "tsx": "^4.23.15",
        "typescript": "^5.2.2",
        "typescript-eslint": "~8.46.4",
        "vite": "^6.4.5"
    }
}
